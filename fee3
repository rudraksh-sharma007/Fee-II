<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>4x4 Board (HTML/CSS)</title>
    <style>
        /* 4x4 black & white board, 50px squares; no JavaScript */
        html,body{height:100%;margin:0}
        body{display:flex;align-items:center;justify-content:center;height:100vh;background:#fff}
        .board{display:grid;grid-template-columns:repeat(4,50px);grid-template-rows:repeat(4,50px);gap:0;border:2px solid #000}
        .square{width:50px;height:50px}
        .square.white{background:#fff}
        .square.black{background:#000}
    </style>
</head>
<body>
    <div class="board" aria-label="4 by 4 chess board">
        <div class="square white"></div>
        <div class="square black"></div>
        <div class="square white"></div>
        <div class="square black"></div>

        <div class="square black"></div>
        <div class="square white"></div>
        <div class="square black"></div>
        <div class="square white"></div>

        <div class="square white"></div>
        <div class="square black"></div>
        <div class="square white"></div>
        <div class="square black"></div>

        <div class="square black"></div>
        <div class="square white"></div>
        <div class="square black"></div>
        <div class="square white"></div>
    </div>
</body>
</html>
